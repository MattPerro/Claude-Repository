# Copia in .env e compila. Tutte le chiavi sono gratuite; nessuna è obbligatoria
# tranne SOSOVALUE_API_KEY per i flussi ETF automatici.

# Percorso del database SQLite
BTCMON_DB_PATH=data/btcmon.sqlite

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) - opzionale.
# Senza chiave si usa l'export CSV pubblico; con la chiave si usano le vintage
# ALFRED per sapere quando ogni dato è stato pubblicato davvero.
FRED_API_KEY=

# CoinGecko Demo key - opzionale (senza chiave: pool pubblico ~5-30 chiamate/min)
COINGECKO_DEMO_API_KEY=

# SoSoValue (https://sosovalue.com/developer) - necessaria per i flussi ETF automatici.
# Senza chiave usa: btcmon manual etf-flow ...  oppure  btcmon import-csv etf_flows file.csv
SOSOVALUE_API_KEY=

# Componenti dell'aggregato M2 (codici separati da virgola): US, EZ
BTCMON_M2_COMPONENTS=US,EZ
