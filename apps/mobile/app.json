{
  "expo": {
    "name": "TrackStrong",
    "slug": "trackstrong",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trackstrong",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.trackstrong",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "TrackStrong",
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9302A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "comment": "Il bundleIdentifier va sostituito con uno tuo (es. com.tuonome.trackstrong) prima della build. Vedi INSTALL_IPHONE.md. Nessun identificativo di progetto EAS: la build e' locale."
    }
  }
}
