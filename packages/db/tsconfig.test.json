{
  "// nota": "Progetto separato per i soli test: tsconfig.json resta 'composite' con rootDir=src, come packages/core, e non puo' includere anche test/.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@trackstrong/core": ["../core/src/index.ts"],
      "@trackstrong/db": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
